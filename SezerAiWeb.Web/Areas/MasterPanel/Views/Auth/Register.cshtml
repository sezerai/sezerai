@{
    ViewData["Title"] = "Register | SEZER AI OS";
    Layout = null;
}

<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "primary": "#735c00",
                        "primary-container": "#d4af37",
                        "on-primary": "#ffffff",
                        "secondary": "#003ec6",
                        "surface": "#f7f9fc",
                        "on-surface": "#191c1e",
                        "on-surface-variant": "#4d4635",
                        "outline": "#7f7663",
                        "outline-variant": "#d0c5af",
                        "error": "#ba1a1a"
                    },
                    "fontFamily": {
                        "display-lg": ["Hanken Grotesk"],
                        "title-sm": ["Hanken Grotesk"],
                        "body-md": ["Hanken Grotesk"],
                        "label-xs": ["Hanken Grotesk"]
                    }
                }
            }
        }
    </script>
    <style>
        body {
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            background: #f7f9fc;
            font-family: 'Hanken Grotesk', sans-serif;
        }

        .mesh-gradient {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(at 0% 0%, rgba(212, 175, 55, 0.05) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(255, 255, 255, 0.8) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(212, 175, 55, 0.03) 0px, transparent 50%),
                radial-gradient(at 0% 100%, rgba(255, 255, 255, 0.8) 0px, transparent 50%);
            z-index: -1;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.05);
        }

        .gold-gradient-btn {
            background: linear-gradient(135deg, #d4af37 0%, #f1e095 50%, #e9c349 100%);
            transition: all 0.3s ease;
        }

            .gold-gradient-btn:hover {
                box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
                filter: brightness(1.05);
            }

        .input-glass {
            background: rgba(255, 255, 255, 0.4);
            border: 1px solid rgba(212, 175, 55, 0.1);
            transition: all 0.2s ease;
        }

            .input-glass:focus {
                background: rgba(255, 255, 255, 0.7);
                border-color: rgba(212, 175, 55, 0.4);
                box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.1);
                outline: none;
            }

        .shimmer {
            position: relative;
            overflow: hidden;
        }

            .shimmer::after {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: linear-gradient( to bottom right, rgba(255,255,255,0) 0%, rgba(255,255,255,0) 40%, rgba(255,255,255,0.4) 50%, rgba(255,255,255,0) 60%, rgba(255,255,255,0) 100% );
                transform: rotate(45deg);
                animation: shimmer 6s infinite;
            }

        @@keyframes shimmer {
            0% {
                transform: translateX(-150%) rotate(45deg);
            }

            100% {
                transform: translateX(150%) rotate(45deg);
            }
        }

        .alert {
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 16px;
            font-size: 14px;
        }

        .alert-error {
            background: rgba(186, 26, 26, 0.1);
            border: 1px solid rgba(186, 26, 26, 0.3);
            color: #ba1a1a;
        }
    </style>
</head>
<body>
    <div class="mesh-gradient"></div>

    <!-- TopNavBar -->
    <header class="fixed top-0 left-0 w-full flex justify-between items-center px-8 md:px-16 py-4 backdrop-blur-md bg-white/10 z-50">
        <div class="font-bold text-2xl text-[#735c00] flex items-center gap-2">
            <span>SEZER AI OS</span>
        </div>
        <div class="flex items-center gap-6 text-[#191c1e]">
            <div class="hidden md:flex items-center gap-4 text-sm opacity-60">
                <span>@DateTime.Now.ToString("dd MMMM yyyy")</span>
                <span>@DateTime.Now.ToString("HH:mm")</span>
            </div>
        </div>
    </header>

    <!-- Main Register Container -->
    <main class="min-h-screen w-full flex flex-col items-center justify-center px-6 pt-20 pb-20">
        <div class="glass-card w-full max-w-[520px] rounded-3xl p-10 md:p-12 relative overflow-hidden">
            <!-- Top Branding -->
            <div class="flex flex-col items-center mb-8">
                <div class="w-24 h-24 mb-4 rounded-full overflow-hidden shadow-sm bg-white/40 border border-white/60 p-2 shimmer">
                    <img alt="SEZER AI Logo" class="w-full h-full object-contain"
                         src="https://lh3.googleusercontent.com/aida-public/AB6AXuBcyRpxyaQi0c7ShvrB2HiLxekegizIwjwbADe4XBS4rQBsk-Bk6xrRWheLNNKkdDSnSCep9ABZiCrZo0ye7HiZKIluxR1np0fK9Qz9JRMBxFUnhk9Gwny1wz6XTqYq7lM7aQ4ApMHEGA5RjYFGbNRicvwEw4LH11ti_Oqv6uJS1VDWPWbf1ERCnrbpz3IzeB_80a_3iAnmPN-RwR7D13NSLY38TWROd37TuWwHZN55elCDVfK0KOl0bmBvtnQSgzPRNDUr3HzpgQ" />
                </div>
                <h1 class="text-2xl text-[#735c00] tracking-tight mb-1 font-semibold">Create Account</h1>
                <p class="text-sm text-[#7f7663] opacity-60">Join SEZER AI Master Control Center</p>
            </div>

            <!-- Error Messages -->
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">
                    @TempData["Error"]
                </div>
            }

            <!-- Register Form -->
            <div class="space-y-5">
                <form asp-area="MasterPanel" asp-controller="Auth" asp-action="Register" method="post" class="space-y-4">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-2">
                            <label class="text-xs text-[#4d4635] ml-1">First Name</label>
                            <input name="FirstName" type="text" required
                                   class="input-glass w-full h-[48px] px-4 rounded-xl text-sm text-[#191c1e] placeholder:text-[#7f7663]/50"
                                   placeholder="John" />
                        </div>
                        <div class="space-y-2">
                            <label class="text-xs text-[#4d4635] ml-1">Last Name</label>
                            <input name="LastName" type="text" required
                                   class="input-glass w-full h-[48px] px-4 rounded-xl text-sm text-[#191c1e] placeholder:text-[#7f7663]/50"
                                   placeholder="Doe" />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-xs text-[#4d4635] ml-1">Email Address</label>
                        <input name="Email" type="email" required
                               class="input-glass w-full h-[48px] px-4 rounded-xl text-sm text-[#191c1e] placeholder:text-[#7f7663]/50"
                               placeholder="admin@sezerai.tr" />
                    </div>

                    <div class="space-y-2">
                        <label class="text-xs text-[#4d4635] ml-1">Password</label>
                        <input name="Password" type="password" required minlength="8"
                               class="input-glass w-full h-[48px] px-4 rounded-xl text-sm text-[#191c1e] placeholder:text-[#7f7663]/50"
                               placeholder="••••••••" />
                        <p class="text-xs text-[#7f7663] ml-1 mt-1">Minimum 8 characters</p>
                    </div>

                    <div class="space-y-2">
                        <label class="text-xs text-[#4d4635] ml-1">Confirm Password</label>
                        <input name="ConfirmPassword" type="password" required minlength="8"
                               class="input-glass w-full h-[48px] px-4 rounded-xl text-sm text-[#191c1e] placeholder:text-[#7f7663]/50"
                               placeholder="••••••••" />
                    </div>

                    <button type="submit"
                            class="gold-gradient-btn w-full h-[52px] mt-4 rounded-xl font-semibold text-white flex items-center justify-center gap-2 shadow-lg active:scale-[0.98]">
                        Create Account
                        <span class="material-symbols-outlined text-[18px]">person_add</span>
                    </button>
                </form>

                <div class="pt-2 text-center">
                    <p class="text-sm text-[#4d4635]">
                        Already have an account?
                        <a asp-area="MasterPanel" asp-controller="Auth" asp-action="Login"
                           class="text-[#735c00] font-semibold hover:underline ml-1">Sign in</a>
                    </p>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="fixed bottom-0 w-full flex flex-col md:flex-row justify-between items-center px-8 md:px-16 py-6 text-xs text-[#4d4635]/60">
        <div class="mb-4 md:mb-0">
            © 2026 SEZER AI OS. All rights reserved.
        </div>
        <div class="flex gap-8">
            <a href="#" class="hover:text-[#735c00] transition-colors duration-200">Privacy Policy</a>
            <a href="#" class="hover:text-[#735c00] transition-colors duration-200">Terms of Service</a>
            <a href="#" class="hover:text-[#735c00] transition-colors duration-200">Help Center</a>
        </div>
    </footer>

    <script>
        // Micro-interaction for input fields
        const inputs = document.querySelectorAll('input');
        inputs.forEach(input => {
            input.addEventListener('focus', () => {
                const label = input.closest('.space-y-2')?.querySelector('label');
                if (label) {
                    label.classList.add('text-[#735c00]');
                    label.classList.remove('text-[#4d4635]');
                }
            });
            input.addEventListener('blur', () => {
                const label = input.closest('.space-y-2')?.querySelector('label');
                if (label) {
                    label.classList.remove('text-[#735c00]');
                    label.classList.add('text-[#4d4635]');
                }
            });
        });

        // Parallax effect
        document.addEventListener('mousemove', (e) => {
            const moveX = (e.clientX - window.innerWidth / 2) * 0.01;
            const moveY = (e.clientY - window.innerHeight / 2) * 0.01;
            document.querySelector('.mesh-gradient').style.transform = `translate(${moveX}px, ${moveY}px)`;
        });
    </script>
</body>
</html>
