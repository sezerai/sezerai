@{
    ViewData["Title"] = "Forgot Password | SEZER AI OS";
    Layout = null;
}

<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "primary": "#735c00",
                        "primary-container": "#d4af37",
                        "on-primary": "#ffffff",
                        "secondary": "#003ec6",
                        "surface": "#f7f9fc",
                        "on-surface": "#191c1e",
                        "on-surface-variant": "#4d4635",
                        "outline": "#7f7663",
                        "outline-variant": "#d0c5af",
                        "error": "#ba1a1a",
                        "success": "#34a853"
                    },
                    "fontFamily": {
                        "display-lg": ["Hanken Grotesk"],
                        "title-sm": ["Hanken Grotesk"],
                        "body-md": ["Hanken Grotesk"],
                        "label-xs": ["Hanken Grotesk"]
                    }
                }
            }
        }
    </script>
    <style>
        body {
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            background: #f7f9fc;
            font-family: 'Hanken Grotesk', sans-serif;
        }

        .mesh-gradient {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(at 0% 0%, rgba(212, 175, 55, 0.05) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(255, 255, 255, 0.8) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(212, 175, 55, 0.03) 0px, transparent 50%),
                radial-gradient(at 0% 100%, rgba(255, 255, 255, 0.8) 0px, transparent 50%);
            z-index: -1;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.05);
        }

        .gold-gradient-btn {
            background: linear-gradient(135deg, #d4af37 0%, #f1e095 50%, #e9c349 100%);
            transition: all 0.3s ease;
        }

            .gold-gradient-btn:hover {
                box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
                filter: brightness(1.05);
            }

        .input-glass {
            background: rgba(255, 255, 255, 0.4);
            border: 1px solid rgba(212, 175, 55, 0.1);
            transition: all 0.2s ease;
        }

            .input-glass:focus {
                background: rgba(255, 255, 255, 0.7);
                border-color: rgba(212, 175, 55, 0.4);
                box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.1);
                outline: none;
            }

        .shimmer {
            position: relative;
            overflow: hidden;
        }

            .shimmer::after {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: linear-gradient( to bottom right, rgba(255,255,255,0) 0%, rgba(255,255,255,0) 40%, rgba(255,255,255,0.4) 50%, rgba(255,255,255,0) 60%, rgba(255,255,255,0) 100% );
                transform: rotate(45deg);
                animation: shimmer 6s infinite;
            }

        @@keyframes shimmer {
            0% {
                transform: translateX(-150%) rotate(45deg);
            }

            100% {
                transform: translateX(150%) rotate(45deg);
            }
        }

        .alert {
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 16px;
            font-size: 14px;
        }

        .alert-error {
            background: rgba(186, 26, 26, 0.1);
            border: 1px solid rgba(186, 26, 26, 0.3);
            color: #ba1a1a;
        }

        .alert-success {
            background: rgba(52, 168, 83, 0.1);
            border: 1px solid rgba(52, 168, 83, 0.3);
            color: #34a853;
        }

        .alert-info {
            background: rgba(0, 62, 198, 0.1);
            border: 1px solid rgba(0, 62, 198, 0.3);
            color: #003ec6;
        }
    </style>
</head>
<body>
    <div class="mesh-gradient"></div>

    <!-- TopNavBar -->
    <header class="fixed top-0 left-0 w-full flex justify-between items-center px-8 md:px-16 py-4 backdrop-blur-md bg-white/10 z-50">
        <div class="font-bold text-2xl text-[#735c00] flex items-center gap-2">
            <span>SEZER AI OS</span>
        </div>
        <div class="flex items-center gap-6 text-[#191c1e]">
            <div class="hidden md:flex items-center gap-4 text-sm opacity-60">
                <span>@DateTime.Now.ToString("dd MMMM yyyy")</span>
                <span>@DateTime.Now.ToString("HH:mm")</span>
            </div>
        </div>
    </header>

    <!-- Main Forgot Password Container -->
    <main class="min-h-screen w-full flex flex-col items-center justify-center px-6 pt-20 pb-20">
        <div class="glass-card w-full max-w-[480px] rounded-3xl p-10 md:p-12 relative overflow-hidden">
            <!-- Top Branding -->
            <div class="flex flex-col items-center mb-8">
                <div class="w-20 h-20 mb-4 rounded-full flex items-center justify-center bg-white/40 border border-white/60 shimmer">
                    <span class="material-symbols-outlined text-[40px] text-[#735c00]">lock_reset</span>
                </div>
                <h1 class="text-2xl text-[#735c00] tracking-tight mb-2 font-semibold">Forgot Password?</h1>
                <p class="text-sm text-[#7f7663] opacity-60 text-center">No worries, we'll send you reset instructions</p>
            </div>

            <!-- Error/Success Messages -->
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">
                    @TempData["Error"]
                </div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }
            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info">
                    @TempData["Info"]
                </div>
            }

            <!-- Forgot Password Form -->
            <div class="space-y-6">
                <form asp-area="MasterPanel" asp-controller="Auth" asp-action="ForgotPassword" method="post" class="space-y-4">
                    <div class="space-y-2">
                        <label class="text-xs text-[#4d4635] ml-1">Email Address</label>
                        <div class="relative">
                            <input name="Email" type="email" required
                                   class="input-glass w-full h-[52px] px-4 rounded-xl text-sm text-[#191c1e] placeholder:text-[#7f7663]/50"
                                   placeholder="admin@sezerai.tr" />
                        </div>
                        <p class="text-xs text-[#7f7663] ml-1 mt-1">Enter the email address associated with your account</p>
                    </div>

                    <button type="submit"
                            class="gold-gradient-btn w-full h-[56px] mt-4 rounded-xl font-semibold text-white flex items-center justify-center gap-2 shadow-lg active:scale-[0.98]">
                        Send Reset Link
                        <span class="material-symbols-outlined text-[18px]">send</span>
                    </button>
                </form>

                <div class="pt-2 text-center">
                    <a asp-area="MasterPanel" asp-controller="Auth" asp-action="Login"
                       class="flex items-center justify-center gap-2 text-sm text-[#735c00] font-semibold hover:underline">
                        <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                        Back to Sign in
                    </a>
                </div>
            </div>

            <!-- Info Box -->
            <div class="mt-8 p-4 bg-white/30 rounded-xl border border-[#d0c5af]/30">
                <p class="text-xs text-[#4d4635] leading-relaxed">
                    <span class="font-semibold">Note:</span> If you don't receive an email within a few minutes, please check your spam folder or contact system administrator.
                </p>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="fixed bottom-0 w-full flex flex-col md:flex-row justify-between items-center px-8 md:px-16 py-6 text-xs text-[#4d4635]/60">
        <div class="mb-4 md:mb-0">
            © 2026 SEZER AI OS. All rights reserved.
        </div>
        <div class="flex gap-8">
            <a href="#" class="hover:text-[#735c00] transition-colors duration-200">Privacy Policy</a>
            <a href="#" class="hover:text-[#735c00] transition-colors duration-200">Terms of Service</a>
            <a href="#" class="hover:text-[#735c00] transition-colors duration-200">Help Center</a>
        </div>
    </footer>

    <script>
        // Micro-interaction for input fields
        const inputs = document.querySelectorAll('input');
        inputs.forEach(input => {
            input.addEventListener('focus', () => {
                input.parentElement.previousElementSibling.classList.add('text-[#735c00]');
                input.parentElement.previousElementSibling.classList.remove('text-[#4d4635]');
            });
            input.addEventListener('blur', () => {
                input.parentElement.previousElementSibling.classList.remove('text-[#735c00]');
                input.parentElement.previousElementSibling.classList.add('text-[#4d4635]');
            });
        });

        // Parallax effect
        document.addEventListener('mousemove', (e) => {
            const moveX = (e.clientX - window.innerWidth / 2) * 0.01;
            const moveY = (e.clientY - window.innerHeight / 2) * 0.01;
            document.querySelector('.mesh-gradient').style.transform = `translate(${moveX}px, ${moveY}px)`;
        });
    </script>
</body>
</html>
