@model List<ProjeKartDto>

<section class="relative h-48 sm:h-80 overflow-hidden">
    <img src="/images/projects/aibazaar-launch.jfif" alt="SEZER AI Technology Projelerimiz" class="absolute inset-0 w-full h-full object-cover" width="1920" height="320" />
    <div class="absolute inset-0 hero-overlay"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex items-end pb-8">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white">Projelerimiz</h1>
    </div>
</section>

<nav aria-label="Breadcrumb" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 text-sm text-text-light">
    <ol class="flex items-center flex-wrap gap-1">
        <li><a href="/" class="hover:text-primary transition-colors">Anasayfa</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-text-dark font-medium">Projelerimiz</li>
    </ol>
</nav>

<section class="py-12 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="sr-only">Tüm Projeler</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            @foreach (var proje in Model)
            {
                <partial name="_ProjeKart" model="proje" />
            }
        </div>
    </div>
</section>
