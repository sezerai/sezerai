@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<section class="py-16 sm:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-text-dark mb-4">Bir Hata Oluştu</h1>
        <div class="w-24 h-1 gold-gradient-bg mx-auto rounded-full mb-6"></div>
        <p class="text-text-light text-base sm:text-lg leading-relaxed mb-6">
            İşleminiz sırasında beklenmeyen bir hata oluştu. Lütfen tekrar deneyin veya ana sayfaya dönün.
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="text-sm text-text-light mb-6">
                <strong>Hata Kodu:</strong> <code class="bg-surface-alt px-2 py-1 rounded text-xs">@Model.RequestId</code>
            </p>
        }

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/" class="inline-flex items-center justify-center px-8 py-3.5 bg-primary text-white font-bold rounded-lg hover:bg-primary-light transition-colors text-sm sm:text-base min-h-[44px]">
                Ana Sayfaya Dön
            </a>
            <button onclick="history.back()" class="inline-flex items-center justify-center px-8 py-3.5 border-2 border-primary text-primary font-bold rounded-lg hover:bg-primary hover:text-white transition-colors text-sm sm:text-base min-h-[44px]">
                Geri Dön
            </button>
        </div>
    </div>
</section>
