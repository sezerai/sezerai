@model BlogDetayDto

<section class="relative h-48 sm:h-72 overflow-hidden">
    <img src="@Model.KapakGorseli" alt="@Model.Baslik" class="absolute inset-0 w-full h-full object-cover" width="1920" height="288" />
    <div class="absolute inset-0 hero-overlay"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex items-end pb-8">
        <div>
            <h1 class="text-2xl sm:text-4xl font-extrabold text-white">@Model.Baslik</h1>
            <p class="text-gold-light text-sm sm:text-base mt-2">@Model.YayinTarihi.ToString("dd MMMM yyyy") · @Model.Yazar</p>
        </div>
    </div>
</section>

<nav aria-label="Breadcrumb" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-3 text-sm text-text-light">
    <ol class="flex items-center flex-wrap gap-1">
        <li><a href="/" class="hover:text-primary transition-colors">Anasayfa</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/blog" class="hover:text-primary transition-colors">Blog</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-text-dark font-medium">@Model.Baslik</li>
    </ol>
</nav>

<article class="py-8 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose-blog overflow-hidden">
        @Html.Raw(Model.IcerikHtml)
    </div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-10">
        <a href="/blog" class="inline-flex items-center gap-2 text-primary font-semibold hover:text-primary-light transition-colors">
            <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            Tüm Yazılara Dön
        </a>
    </div>
</article>
