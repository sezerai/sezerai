@model ProjeKartDto
<a href="/projelerimiz/@Model.Slug" class="group rounded-2xl silver-border-card overflow-hidden scroll-reveal">
    <div class="relative h-36 sm:h-48 bg-ink-light overflow-hidden">
        <img src="@Model.KapakGorseli" alt="@Model.Ad - SEZER AI Technology projesi" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" width="400" height="240" />
    </div>
    <div class="p-5">
        <h3 class="text-lg font-bold text-white group-hover:text-gold-light transition-colors mb-2">@Model.Ad</h3>
        <p class="text-sm text-white/50 leading-relaxed">@Model.KisaAciklama</p>
        <span class="inline-flex items-center gap-1 mt-3 text-sm font-semibold text-gold-light">
            Detaylar
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </span>
    </div>
</a>
