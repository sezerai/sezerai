@model IletisimFormDto

<section class="relative h-48 sm:h-64 overflow-hidden">
    <img src="/images/projects/sezerai-corporate.jfif" alt="SEZER AI Technology İletişim" class="absolute inset-0 w-full h-full object-cover" width="1920" height="256" />
    <div class="absolute inset-0 hero-overlay"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex items-end pb-8">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white">İletişim</h1>
    </div>
</section>

<nav aria-label="Breadcrumb" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 text-sm text-text-light">
    <ol class="flex items-center flex-wrap gap-1">
        <li><a href="/" class="hover:text-primary transition-colors">Anasayfa</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-text-dark font-medium">İletişim</li>
    </ol>
</nav>

<section class="py-12 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div class="scroll-reveal">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-text-dark mb-2">Bize Ulaşın</h2>
            <div class="w-20 h-1 gold-gradient-bg rounded-full mb-6"></div>

            @if (TempData["IletisimBasarili"] is string basariMesaji)
            {
                <div class="bg-gold-light text-primary font-semibold rounded-lg p-4 mb-6">@basariMesaji</div>
            }

            <form asp-controller="Iletisim" asp-action="Index" method="post" class="bg-white rounded-lg p-6 sm:p-8 gold-border-static space-y-4">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>
                <div>
                    <label asp-for="AdSoyad" class="block text-sm font-medium text-text-dark mb-1">Ad Soyad *</label>
                    <input asp-for="AdSoyad" class="w-full rounded-lg border border-border px-4 py-3 min-h-[44px] focus:outline-none focus:ring-2 focus:ring-gold" />
                    <span asp-validation-for="AdSoyad" class="text-red-600 text-xs"></span>
                </div>
                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-text-dark mb-1">E-posta *</label>
                    <input asp-for="Email" class="w-full rounded-lg border border-border px-4 py-3 min-h-[44px] focus:outline-none focus:ring-2 focus:ring-gold" />
                    <span asp-validation-for="Email" class="text-red-600 text-xs"></span>
                </div>
                <div>
                    <label asp-for="Telefon" class="block text-sm font-medium text-text-dark mb-1">Telefon</label>
                    <input asp-for="Telefon" class="w-full rounded-lg border border-border px-4 py-3 min-h-[44px] focus:outline-none focus:ring-2 focus:ring-gold" />
                </div>
                <div>
                    <label asp-for="Konu" class="block text-sm font-medium text-text-dark mb-1">Konu *</label>
                    <input asp-for="Konu" class="w-full rounded-lg border border-border px-4 py-3 min-h-[44px] focus:outline-none focus:ring-2 focus:ring-gold" />
                    <span asp-validation-for="Konu" class="text-red-600 text-xs"></span>
                </div>
                <div>
                    <label asp-for="Mesaj" class="block text-sm font-medium text-text-dark mb-1">Mesajınız *</label>
                    <textarea asp-for="Mesaj" rows="5" class="w-full rounded-lg border border-border px-4 py-3 focus:outline-none focus:ring-2 focus:ring-gold"></textarea>
                    <span asp-validation-for="Mesaj" class="text-red-600 text-xs"></span>
                </div>
                <button type="submit" class="w-full px-8 py-3.5 min-h-[44px] bg-primary text-white font-bold rounded-lg hover:bg-primary-light transition-colors">Mesaj Gönder</button>
            </form>
        </div>

        <div class="scroll-reveal">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-text-dark mb-2">İletişim Bilgileri</h2>
            <div class="w-20 h-1 gold-gradient-bg rounded-full mb-6"></div>
            <ul class="space-y-3 text-text-light mb-8">
                <li><strong class="text-text-dark">Telefon:</strong> +90 541 195 53 04</li>
                <li><strong class="text-text-dark">Adres:</strong> Düzce Üniversitesi Teknopark, Düzce</li>
            </ul>
            <div class="rounded-lg overflow-hidden gold-border-card h-72 sm:h-96">
                <iframe
                    title="Düzce Üniversitesi Teknopark konumu"
                    src="https://www.google.com/maps?q=D%C3%BCzce%20%C3%9Cniversitesi%20Teknopark&output=embed"
                    class="w-full h-full border-0"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade">
                </iframe>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
