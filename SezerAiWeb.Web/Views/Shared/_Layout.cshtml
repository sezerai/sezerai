@{
    var seo = ViewData["Seo"] as SeoMeta ?? new SeoMeta();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="SEZER AI" />
    <link rel="apple-touch-icon" href="/images/logo-sezerai.png" />
    <link rel="icon" href="/images/logo-sezerai.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <partial name="_SeoMeta" model="seo" />

    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Organization",
        "name": "SEZER AI Technology",
        "legalName": "SETINT AI Robotic Sistem Egitim ve Danismanlik San. ve Tic. A.S.",
        "url": "https://www.sezerai.tr",
        "logo": "https://www.sezerai.tr/images/logo-sezerai.png",
        "foundingDate": "2019",
        "address": { "@@type": "PostalAddress", "addressLocality": "Duzce", "addressCountry": "TR" }
    }
    </script>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#002855",
                        "primary-light": "#1a4a8a",
                        gold: "#d4af37",
                        "gold-light": "#f2ca50",
                        "gold-dark": "#9a7512",
                        ink: "#0a0a0a",
                        "ink-light": "#171717",
                        silver: "#c7c9cc",
                        "silver-light": "#e8e9ea",
                        "silver-dark": "#8a8d91",
                        surface: "#ffffff",
                        "surface-alt": "#f5f5f5",
                        text: "#222222",
                        "text-dark": "#111111",
                        "text-light": "#666666",
                        border: "#e5e5e5",
                    },
                    fontFamily: {
                        sans: ["Montserrat", "Segoe UI", "sans-serif"],
                    },
                },
            },
        };
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-white text-text antialiased">
    <partial name="_Navbar" />

    <main class="flex-1">
        @RenderBody()
    </main>

    <partial name="_Footer" />

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
